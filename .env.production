# The public address of the live site.
#
# Vite substitutes %VITE_SITE_URL% into index.html and privacy.html at build
# time, for the canonical link and the og:/twitter: tags that make shared links
# show a preview card. Without this file those tags build as the literal text
# "%VITE_SITE_URL%" and every share of the game looks broken.
VITE_SITE_URL=https://dinozoa.com
